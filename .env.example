# Copy this file to .env and fill in real values. Never commit the real .env file.

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Upstash Vector (https://console.upstash.com/vector) — REST URL and token for your index
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Shared secret required by POST /admin/reindex.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_KEY=

# Optional. Currently unused by the code (reserved for future Upstash namespacing).
COLLECTION_NAME=org-rag
