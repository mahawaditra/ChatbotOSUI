# Copy this file to .env and fill in real values. Never commit the real .env file.

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Upstash Redis (https://console.upstash.com/redis) — used only for rate-limiting
# POST /api/chat (10 req/min per IP by default). Unrelated to the local vector store
# (data/vector_store/), which needs no credentials at all — see README.md.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret required by POST /admin/reindex. Must be at least 32 characters
# (app fails to start otherwise). Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_KEY=
