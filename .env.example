# Copy this file to .env and fill in real values. Never commit the real .env file.

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Upstash Vector (https://console.upstash.com/vector) — REST URL and token for your index
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Upstash Redis (https://console.upstash.com/redis) — a SEPARATE database from the Vector
# one above. Used only for rate-limiting POST /api/chat (10 req/min per IP by default).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret required by POST /admin/reindex. Must be at least 32 characters
# (app fails to start otherwise). Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_KEY=

# Optional. Currently unused by the code (reserved for future Upstash namespacing).
COLLECTION_NAME=org-rag
